[Unit]
Description=Dispara a publicacao de metricas do Controlog a cada cinco minutos
Documentation=https://github.com/davigpe/controlog/blob/main/docs/OBSERVABILIDADE.md

[Timer]
# OnCalendar, e nao OnUnitActiveSec. A primeira versao usava
# `OnUnitActiveSec=5min`, que ancora o proximo disparo na ultima ATIVACAO do
# servico — e um `Type=oneshot` que falha nao registra ativacao. Resultado real
# observado: o servico falhou na primeira execucao e o timer ficou sem proximo
# disparo nenhum, com `NEXT -` e `LEFT -` no `systemctl list-timers`. O
# monitoramento morria junto com a primeira falha, que e exatamente quando ele
# precisa continuar tentando.
#
# OnCalendar e absoluto: dispara nos minutos 0, 5, 10... de toda hora,
# independentemente de a execucao anterior ter dado certo.
#
# Cinco minutos para casar com o periodo dos alarmes de memoria e disco, que
# avaliam dois periodos de 300 s.
OnCalendar=*:0/5

# Se a instancia estiver desligada na hora do disparo, executa na volta em vez
# de pular. So tem efeito com OnCalendar — em timer monotonico o systemd ignora
# esta diretiva, e era outro erro da primeira versao.
Persistent=true

# Espalha o disparo em ate 30 s. Irrelevante com uma instancia so, mas e o
# padrao certo e nao custa nada.
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
