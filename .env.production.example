# Modelo do .env.production usado pelo docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#
# O .env.production real NÃO vai para o Git (está no .gitignore). Ele fica
# apenas no servidor.

# ─── Banco ────────────────────────────────────────────────────────────────
# Com RDS, as duas apontam para a mesma instância: DIRECT_URL só existe
# porque o Prisma pede uma conexão sem pooler para rodar as migrations, e o
# RDS não tem pooler na frente (diferente do Neon, usado antes).
#
# O host "api" alcança o RDS pela rede da VPC; copie o endpoint do painel.
DATABASE_URL="postgresql://controlog:TROQUE_ESTA_SENHA@SEU-ENDPOINT.rds.amazonaws.com:5432/controlog?schema=public&sslmode=require"
DIRECT_URL="postgresql://controlog:TROQUE_ESTA_SENHA@SEU-ENDPOINT.rds.amazonaws.com:5432/controlog?schema=public&sslmode=require"

# Se optar pelo Postgres em contêiner (perfil db-local), use estas no lugar
# das duas de cima e preencha POSTGRES_PASSWORD mais abaixo:
# DATABASE_URL="postgresql://controlog:TROQUE_ESTA_SENHA@db:5432/controlog?schema=public"
# DIRECT_URL="postgresql://controlog:TROQUE_ESTA_SENHA@db:5432/controlog?schema=public"
# POSTGRES_USER=controlog
# POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
# POSTGRES_DB=controlog

# ─── Autenticação ─────────────────────────────────────────────────────────
# Gere cada um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Nunca reaproveite os valores do .env.example: aqueles são públicos.
JWT_SECRET="GERE_UM_VALOR_ALEATORIO"
JWT_REFRESH_SECRET="GERE_OUTRO_VALOR_ALEATORIO"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Rede ─────────────────────────────────────────────────────────────────
# Nesta arquitetura o site e a API são servidos pelo mesmo host, então não há
# origem cruzada e o CORS não chega a ser exercitado. A variável segue aqui
# para o caso de o frontend passar a ser servido de outro lugar (S3 +
# CloudFront, por exemplo) — aí ela precisa ser a URL pública do site.
CORS_ORIGIN="https://SEU-DOMINIO"

# Domínio próprio, usado só pelo docker-compose.https.yml: é o nome para o
# qual o Caddy pede o certificado. Sem "https://" e sem barra no fim.
CONTROLOG_DOMAIN="SEU-DOMINIO"

# Quantos saltos de proxy reverso confiar no X-Forwarded-For. Errar o número
# faz o rate limiter tratar todos os usuários como um só IP.
#   1 → só o nginx         (docker-compose.prod.yml, em HTTP)
#   2 → Caddy + nginx      (docker-compose.https.yml, em HTTPS)
TRUST_PROXY=2

# ─── E-mail ───────────────────────────────────────────────────────────────
# "ses" envia de verdade pelo Amazon SES; "registro" só escreve o link no log
# do servidor (é o padrão, e o que se usa em desenvolvimento).
#
# Não há chave de API aqui de propósito: na instância, o SDK pega a credencial
# do instance profile (role controlog-ec2-ssm, criada em infra/cicd.yml), então
# nenhum segredo de e-mail entra neste arquivo nem no repositório.
EMAIL_TRANSPORTE="ses"

# Precisa ser um endereço do domínio verificado no SES (ver infra/email.yml).
# Com um remetente não verificado, o SES recusa com MessageRejected.
EMAIL_REMETENTE="Controlog <nao-responda@controlog.app>"

# Para onde vai a resposta de quem responder ao e-mail automático. Vazio omite
# o cabeçalho, e aí a resposta cai numa caixa que ninguém lê.
EMAIL_RESPONDER_PARA=""

# Região do SES. Em branco, herda AWS_REGION e, na falta dela, us-east-1.
EMAIL_REGIAO="us-east-1"

# ─── Opcional ─────────────────────────────────────────────────────────────
# Chave gratuita em https://openrouteservice.org/dev/#/signup.
# Sem ela, a otimização de rotas cai para estimativa em linha reta.
ORS_API_KEY=""
