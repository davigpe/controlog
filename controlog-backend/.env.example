PORT=3333
NODE_ENV=development

DATABASE_URL="postgresql://controlog:controlog@localhost:5433/controlog?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="change-me-too-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

# Opcional — número de proxies reversos na frente da API (usado pelo rate limit pra
# ler o IP real do cliente). Padrão: 1 em produção (Railway) e desligado em dev/test.
# TRUST_PROXY=1

# Opcional — chave gratuita em https://openrouteservice.org/dev/#/signup.
# Sem ela, a otimização de rotas cai pra estimativa em linha reta.
ORS_API_KEY=""
