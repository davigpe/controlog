PORT=3333
NODE_ENV=development

# Local (Docker): mesma connection string nas duas variáveis.
# Neon (produção): DATABASE_URL leva "-pooler" no host (usada em runtime);
# DIRECT_URL é a connection string direta, sem "-pooler" (usada só pelo
# Prisma CLI em `migrate deploy`/`migrate dev`).
DATABASE_URL="postgresql://controlog:controlog@localhost:5433/controlog?schema=public"
DIRECT_URL="postgresql://controlog:controlog@localhost:5433/controlog?schema=public"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="change-me-too-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

# Opcional — chave gratuita em https://openrouteservice.org/dev/#/signup.
# Sem ela, a otimização de rotas cai pra estimativa em linha reta.
ORS_API_KEY=""
