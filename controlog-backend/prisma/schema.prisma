// Modelo de dados baseado no Apêndice D do RFC — Controlog
// https://c4model.com — Nível 3: Componentes da REST API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UsuarioPerfil {
  GESTOR
  OPERADOR
  MOTORISTA
}

enum MotoristaStatus {
  ATIVO
  INATIVO
}

enum VeiculoStatus {
  DISPONIVEL
  MANUTENCAO
  INATIVO
}

enum RotaStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum EntregaStatus {
  PENDENTE
  EM_TRANSITO
  ENTREGUE
  CANCELADA
}

model Usuario {
  id                  String        @id @default(uuid())
  nome                String
  email               String        @unique
  senhaHash           String        @map("senha_hash")
  perfil              UsuarioPerfil @default(OPERADOR)
  resetTokenHash      String?       @map("reset_token_hash")
  resetTokenExpiraEm  DateTime?     @map("reset_token_expira_em")
  criadoEm            DateTime      @default(now()) @map("criado_em")

  @@map("usuarios")
}

model Motorista {
  id        String          @id @default(uuid())
  nome      String
  cnh       String          @unique
  telefone  String
  status    MotoristaStatus @default(ATIVO)
  criadoEm  DateTime        @default(now()) @map("criado_em")

  rotas    Rota[]
  entregas Entrega[]

  @@map("motoristas")
}

model Veiculo {
  id          String        @id @default(uuid())
  placa       String        @unique
  modelo      String
  capacidade  String
  status      VeiculoStatus @default(DISPONIVEL)
  criadoEm    DateTime      @default(now()) @map("criado_em")

  rotas Rota[]

  @@map("veiculos")
}

model Rota {
  id             String     @id @default(uuid())
  codigo         String     @unique
  origem         String
  destino        String
  latOrigem      Float      @map("lat_origem")
  lngOrigem      Float      @map("lng_origem")
  latDestino     Float      @map("lat_destino")
  lngDestino     Float      @map("lng_destino")
  status         RotaStatus @default(ATIVA)
  dataHora       DateTime   @map("data_hora")
  criadoEm       DateTime   @default(now()) @map("criado_em")

  motoristaId String    @map("motorista_id")
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Restrict)

  veiculoId String  @map("veiculo_id")
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  entregas Entrega[]

  @@map("rotas")
}

model Entrega {
  id            String        @id @default(uuid())
  codigo        String        @unique
  destino       String
  status        EntregaStatus @default(PENDENTE)
  dataPrevista  DateTime      @map("data_prevista")
  dataEfetiva   DateTime?     @map("data_efetiva")
  criadoEm      DateTime      @default(now()) @map("criado_em")

  rotaId String @map("rota_id")
  rota   Rota   @relation(fields: [rotaId], references: [id], onDelete: Restrict)

  motoristaId String    @map("motorista_id")
  motorista   Motorista @relation(fields: [motoristaId], references: [id], onDelete: Restrict)

  @@map("entregas")
}
