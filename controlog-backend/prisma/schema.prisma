// Modelo de dados baseado no Apêndice D do RFC — Controlog
// https://c4model.com — Nível 3: Componentes da REST API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: connection string com pooler (usada em runtime pela API).
  // DIRECT_URL: connection string direta, sem pooler (usada só pelo Prisma
  // CLI em `migrate deploy`/`migrate dev`) — necessário com Neon/Supabase
  // porque migrations não funcionam bem através de um pooler transacional.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UsuarioPerfil {
  GESTOR
  OPERADOR
  MOTORISTA
}

enum MotoristaStatus {
  ATIVO
  INATIVO
}

enum VeiculoStatus {
  DISPONIVEL
  MANUTENCAO
  INATIVO
}

// Categoria operacional do veículo — é por ela que a logística decide o que
// cabe em qual carro. Fechada em enum, e não texto livre no modelo, porque
// vira critério de filtro e de agrupamento: "VUC" digitado de cinco jeitos
// não agrega. Ordenada do menor porte ao maior.
enum VeiculoCategoria {
  MOTO
  PASSEIO
  UTILITARIO
  VAN
  VUC
  TRES_QUARTOS
  TOCO
  TRUCK
  CARRETA
  OUTRO
}

enum RotaStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum EntregaStatus {
  PENDENTE
  EM_TRANSITO
  ENTREGUE
  // Tentativa feita e frustrada — diferente de CANCELADA, que é o pedido
  // cancelado antes de sair. O motorista registra, e cabe ao gestor decidir o
  // destino da entrega (reatribuir a outra rota, reagendar ou cancelar).
  NAO_ENTREGUE
  CANCELADA
}

// Motivos fechados em enum em vez de texto livre para que o relatório consiga
// agrupar por causa — "cliente ausente" digitado de dez jeitos não agrega.
enum MotivoInsucesso {
  CLIENTE_AUSENTE
  ENDERECO_NAO_ENCONTRADO
  RECUSADA_PELO_CLIENTE
  AVARIA
  OUTRO
}

enum PlanoStatus {
  ABERTO
  OTIMIZADO
}

model Usuario {
  id                 String        @id @default(uuid())
  nome               String
  email              String        @unique
  senhaHash          String        @map("senha_hash")
  perfil             UsuarioPerfil @default(OPERADOR)
  resetTokenHash     String?       @map("reset_token_hash")
  resetTokenExpiraEm DateTime?     @map("reset_token_expira_em")
  criadoEm           DateTime      @default(now()) @map("criado_em")

  // Preenchido só em usuários de perfil MOTORISTA — é por aqui que a visão
  // restrita ("minhas rotas") descobre de qual Motorista o usuário logado é.
  motorista Motorista?

  @@map("usuarios")
}

model Motorista {
  id       String          @id @default(uuid())
  nome     String
  cnh      String          @unique
  telefone String
  status   MotoristaStatus @default(ATIVO)
  criadoEm DateTime        @default(now()) @map("criado_em")

  // Null enquanto o motorista não tem acesso ao sistema — um gestor cria o
  // login depois (POST /api/motoristas/:id/acesso). onDelete: SetNull para
  // que apagar o usuário não apague o cadastro operacional do motorista.
  usuarioId String?  @unique @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  rotas    Rota[]
  entregas Entrega[]

  @@map("motoristas")
}

model Veiculo {
  id         String           @id @default(uuid())
  placa      String           @unique
  modelo     String
  capacidade String
  // Default OUTRO para que os veículos cadastrados antes desta coluna sigam
  // válidos — "não categorizado" é um estado honesto, melhor do que chutar
  // uma categoria errada para a base que já existe.
  categoria  VeiculoCategoria @default(OUTRO)
  status     VeiculoStatus    @default(DISPONIVEL)
  criadoEm   DateTime         @default(now()) @map("criado_em")

  rotas Rota[]

  @@map("veiculos")
}

model Rota {
  id         String     @id @default(uuid())
  codigo     String     @unique
  origem     String
  destino    String
  latOrigem  Float      @map("lat_origem")
  lngOrigem  Float      @map("lng_origem")
  latDestino Float      @map("lat_destino")
  lngDestino Float      @map("lng_destino")
  status     RotaStatus @default(ATIVA)
  dataHora   DateTime   @map("data_hora")
  criadoEm   DateTime   @default(now()) @map("criado_em")

  // Opcional: uma rota pode ser aprovada antes de se saber quem vai dirigir,
  // e a atribuicao acontece depois (tela de Atribuicao de Rotas). Antes disso
  // era obrigatorio, o que forcava escolher um motorista so para destravar a
  // aprovacao — e trocar depois, sem registro de que a escolha foi provisoria.
  motoristaId String?    @map("motorista_id")
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: Restrict)

  // Null tem dois significados possiveis, desambiguados por veiculoProprio:
  // com a marcacao falsa, o veiculo ainda nao foi definido; com ela
  // verdadeira, a rota sai em veiculo que nao e da frota.
  veiculoId String?  @map("veiculo_id")
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  // O motorista usa veiculo proprio. Sem placa nem descricao de proposito: o
  // que a operacao precisa saber e que aquele trajeto nao consumiu a frota, e
  // nao qual carro era. Um veiculo "PROPRIO" cadastrado na frota resolveria
  // sem campo novo, mas poluiria a listagem, a contagem de disponiveis e os
  // relatorios com uma linha que nao e um veiculo.
  veiculoProprio Boolean @default(false) @map("veiculo_proprio")

  entregas Entrega[]
  pedidos  Pedido[]

  @@map("rotas")
}

model Entrega {
  id              String           @id @default(uuid())
  codigo          String           @unique
  destino         String
  status          EntregaStatus    @default(PENDENTE)
  dataPrevista    DateTime         @map("data_prevista")
  // Quando a entrega chegou ao estado final — preenchida tanto na conclusão
  // quanto no registro de insucesso, que também encerra a tentativa.
  dataEfetiva     DateTime?        @map("data_efetiva")
  // Só preenchidos em NAO_ENTREGUE. A observação é livre porque o motivo
  // fechado nunca cobre o caso concreto ("portaria recusou sem síndico").
  motivoInsucesso MotivoInsucesso? @map("motivo_insucesso")
  observacao      String?
  criadoEm        DateTime         @default(now()) @map("criado_em")

  rotaId String @map("rota_id")
  rota   Rota   @relation(fields: [rotaId], references: [id], onDelete: Restrict)

  // Acompanha a rota: aprovada sem motorista, as entregas dela tambem nascem
  // sem dono, e todas passam a ter um quando a rota e atribuida.
  motoristaId String?    @map("motorista_id")
  motorista   Motorista? @relation(fields: [motoristaId], references: [id], onDelete: Restrict)

  comprovantes ComprovanteEntrega[]

  @@map("entregas")
}

// Prova de que a entrega aconteceu: foto do volume no destino, canhoto
// assinado, print do aceite. Concluir exige pelo menos um — a regra está em
// minhasRotas.service, porque é lá que a conclusão acontece.
//
// Varios por entrega de proposito: na pratica o motorista fotografa o volume
// e o comprovante assinado, e obrigar a escolher um so levaria a juntar tudo
// numa foto ruim.
model ComprovanteEntrega {
  id String @id @default(uuid())

  // Nome gerado pelo servidor, e o unico usado para montar caminho em disco.
  // O nome que o cliente envia vai para `nomeOriginal`, so para exibicao: um
  // "../../.env" vindo do navegador viraria escrita fora da pasta.
  arquivo      String
  nomeOriginal String @map("nome_original")
  mimeType     String @map("mime_type")
  tamanho      Int

  criadoEm DateTime @default(now()) @map("criado_em")

  // Cascade: apagada a entrega, os arquivos perdem dono. A remocao do arquivo
  // em disco e feita pelo service antes de apagar a linha.
  entregaId String  @map("entrega_id")
  entrega   Entrega @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  @@index([entregaId])
  @@map("comprovantes_entrega")
}

model Plano {
  id       String      @id @default(uuid())
  nome     String
  status   PlanoStatus @default(ABERTO)
  criadoEm DateTime    @default(now()) @map("criado_em")

  pedidos Pedido[]

  @@map("planos")
}

// Pedidos fictícios pro módulo de planejamento (Pedidos/Planos) — não tem
// relação com o ERP real nem com o model Entrega (que já representa entregas
// de verdade vinculadas a Rota/Motorista, com suas próprias regras de negócio).
model Pedido {
  id       String   @id @default(uuid())
  codigo   String   @unique
  cliente  String
  endereco String
  cidade   String
  lat      Float
  lng      Float
  unidades Int
  volumeM3 Float    @map("volume_m3")
  criadoEm DateTime @default(now()) @map("criado_em")

  planoId   String? @map("plano_id")
  plano     Plano?  @relation(fields: [planoId], references: [id], onDelete: SetNull)
  // Grupo (1, 2, 3...) atribuído ao otimizar o plano — null até otimizar.
  rotaIndex Int?    @map("rota_index")

  // Preenchido quando o grupo (rotaIndex) é aprovado e vira uma Rota real —
  // null enquanto o grupo ainda não foi aprovado.
  rotaId String? @map("rota_id")
  rota   Rota?   @relation(fields: [rotaId], references: [id], onDelete: SetNull)

  @@map("pedidos")
}
